# ===========================================================================
# Peeko environment configuration
#
# Copy this file to `.env` next to your working directory and fill in the
# values you need. Peeko reads these variables on startup.
#
#   cp .env.example .env
#
# Never commit a real `.env` file. Keep `.env` out of version control
# (it already is, via .gitignore).
#
# Booleans accept: 1/0, true/false, yes/no, on/off.
# ===========================================================================

# --- Stage 0: behaviour ----------------------------------------------------

# Log verbosity: CRITICAL | ERROR | WARNING | INFO | DEBUG
# optional at this stage — defaults to INFO
PEEKO_LOG_LEVEL=INFO

# Smoke-test mode: the app auto-quits ~2 seconds after starting with
# exit code 0. Used to verify the app boots on headless machines:
#   PEEKO_SMOKE_TEST=1 QT_QPA_PLATFORM=offscreen python -m peeko
# optional at this stage — defaults to 0 (off)
PEEKO_SMOKE_TEST=0
# --- Stage 1-2: avatar artwork ---------------------------------------------
# Folder containing your own avatar `manifest.json` + `layers/` SVGs.
# Leave unset to use the placeholder artwork shipped inside the package.
# Stage 2 reaction animations (`hover`, `double_click`, `confused`) are
# optional: if your manifest does not define them, those reactions are
# simply switched off. See peeko/avatar/assets/README.md.
#   PEEKO_AVATAR_ASSETS_DIR=C:\Users\you\peeko-art
# optional — unset for the packaged artwork
# PEEKO_AVATAR_ASSETS_DIR=

# Override where Peeko stores its data/config/logs (defaults follow your
# OS conventions via platformdirs, e.g. %LOCALAPPDATA% on Windows,
# ~/Library/Application Support on macOS, ~/.local/share on Linux).
# optional at this stage — unset for defaults
# PEEKO_DATA_DIR=
# PEEKO_CONFIG_DIR=
# PEEKO_LOG_DIR=

# --- Stage 3: AI chat (WORKING — this is where your key goes) --------------
# Peeko's chat window (right-click the robot -> Talk) talks to an
# OpenAI-compatible chat-completions API. Without a key the window opens and
# tells you plainly that the AI is not configured — it never fakes a reply.

# Provider. "openai" and "openai-compatible" are accepted. Any endpoint that
# speaks the OpenAI chat-completions API works: OpenAI itself, a local server
# (Ollama, LM Studio, llama.cpp) or an aggregator — point
# PEEKO_AI_BASE_URL at it.
# optional — defaults to openai
PEEKO_AI_PROVIDER=openai

# Model name, e.g. gpt-4o-mini. REQUIRED for chatting: Peeko will tell you if
# it is missing instead of guessing a model.
# optional — but the chat window stays disabled until it is set
# PEEKO_AI_MODEL=gpt-4o-mini

# Your API key. REQUIRED for chatting.
# THIS IS A SECRET — never commit a real value, never share it, and keep
# .env out of version control (it already is, via .gitignore).
# Peeko never logs it, never prints it and never sends it anywhere except to
# the provider you configured above.
# optional — leave unset (or copy .env.example to .env and fill it in) until
# you want to use the chat window
# PEEKO_AI_API_KEY=sk-your-key-here

# API root. Leave unset for the provider's documented default
# (https://api.openai.com/v1). Set it to use any OpenAI-compatible endpoint,
# e.g. http://localhost:11434/v1 for a local Ollama server.
# optional — unset means the provider default
# PEEKO_AI_BASE_URL=

# How long Peeko waits for an answer before giving up, in seconds.
# optional — defaults to 30
# PEEKO_AI_TIMEOUT_S=30

# --- Stage 4: voice input (WORKING — speak to Peeko instead of typing) -----
# Click **Mic** in the chat window (right-click the robot -> Talk) to talk:
# Peeko records through your microphone, asks an OpenAI-compatible speech-to-text
# endpoint for the words, and puts them in the message box. Nothing is sent to
# Peeko until you press Send, so you can fix a misheard word first. Recording
# and the HTTP round trip run off the UI thread; the robot never freezes.
#
# The captured audio is kept in memory only (it is never written to disk) and is
# sent to exactly one place: the speech endpoint configured below.
#
# Master switch for the microphone. Set to 0 to turn voice input off
# completely — Peeko then never opens an audio device, and the Mic button
# explains why instead of listening.
# optional — defaults to 1 (on; capturing only ever starts when you click Mic)
# PEEKO_VOICE_ENABLED=1

# Speech-to-text engine. "openai" and "openai-compatible" are accepted (and
# "whisper" is an alias). Anything else is refused with a plain message rather
# than guessed at.
# optional — defaults to openai-compatible
# PEEKO_VOICE_INPUT_ENGINE=openai-compatible

# Transcription model, e.g. whisper-1.
# optional — an unset model uses the engine's documented default
# PEEKO_STT_MODEL=whisper-1

# Speech-to-text API root. Leave unset to reuse PEEKO_AI_BASE_URL (so one
# OpenAI-compatible gateway is configured once for both chat and dictation),
# or set it if your transcription service lives somewhere else.
# optional — falls back to PEEKO_AI_BASE_URL, then to the engine default
# PEEKO_STT_BASE_URL=

# How long Peeko waits for a transcription before giving up, in seconds.
# optional — defaults to 60
# PEEKO_VOICE_TIMEOUT_S=60

# Hard cap on a single recording, in seconds. A microphone you forgot about
# stops itself after this long (click Mic again to stop earlier).
# optional — defaults to 30
# PEEKO_VOICE_MAX_SECONDS=30

# The speech-to-text key is the same PEEKO_AI_API_KEY documented above (one
# key configures both features). Without a key the Mic button says so and no
# audio device is ever opened.

# --- Stage 5: text-to-speech (NOT IMPLEMENTED YET — config only) -----------
# Peeko cannot speak yet: peeko/voice/output.py is an honest Stage 5 stub
# whose methods raise NotImplementedError. These variables are read today so
# the configuration surface is stable, but they have no effect.
# Engine name, e.g. "pyttsx3" (local) or "edge".
# optional — not used until Stage 5
# PEEKO_TTS_ENGINE=
# Voice identifier, e.g. en-US-JennyNeural.
# optional — not used until Stage 5
# PEEKO_TTS_VOICE=
