# ===========================================================================
# Peeko environment configuration
#
# Copy this file to `.env` next to your working directory and fill in the
# values you need. Peeko reads these variables on startup.
#
#   cp .env.example .env
#
# Never commit a real `.env` file. Keep `.env` out of version control
# (it already is, via .gitignore).
#
# Booleans accept: 1/0, true/false, yes/no, on/off.
# ===========================================================================

# --- Stage 0: behaviour ----------------------------------------------------

# Log verbosity: CRITICAL | ERROR | WARNING | INFO | DEBUG
# optional at this stage — defaults to INFO
PEEKO_LOG_LEVEL=INFO

# Smoke-test mode: the app auto-quits ~2 seconds after starting with
# exit code 0. Used to verify the app boots on headless machines:
#   PEEKO_SMOKE_TEST=1 QT_QPA_PLATFORM=offscreen python -m peeko
# optional at this stage — defaults to 0 (off)
PEEKO_SMOKE_TEST=0
# --- Stage 1-2: avatar artwork ---------------------------------------------
# Folder containing your own avatar `manifest.json` + `layers/` SVGs.
# Leave unset to use the placeholder artwork shipped inside the package.
# Stage 2 reaction animations (`hover`, `double_click`, `confused`) are
# optional: if your manifest does not define them, those reactions are
# simply switched off. See peeko/avatar/assets/README.md.
#   PEEKO_AVATAR_ASSETS_DIR=C:\Users\you\peeko-art
# optional — unset for the packaged artwork
# PEEKO_AVATAR_ASSETS_DIR=

# Override where Peeko stores its data/config/logs (defaults follow your
# OS conventions via platformdirs, e.g. %LOCALAPPDATA% on Windows,
# ~/Library/Application Support on macOS, ~/.local/share on Linux).
# optional at this stage — unset for defaults
# PEEKO_DATA_DIR=
# PEEKO_CONFIG_DIR=
# PEEKO_LOG_DIR=

# --- Stage 3: AI chat (NOT IMPLEMENTED YET — config only) ------------------
# Provider: "openai" (others will be supported as stages land).
# optional at this stage — not required for Stage 0
# PEEKO_AI_PROVIDER=openai
# Model name, e.g. gpt-4o-mini.
# optional at this stage — not required for Stage 0
# PEEKO_AI_MODEL=
# Your API key. THIS IS A SECRET — never commit a real value, never share it.
# Peeko never logs it. Unset until Stage 3.
# optional at this stage — not required for Stage 0
# PEEKO_AI_API_KEY=

# --- Stage 4: voice input (NOT IMPLEMENTED YET — config only) --------------
# Engine name, e.g. "whisper" (local) or "openai".
# optional at this stage — not required for Stage 0
# PEEKO_VOICE_INPUT_ENGINE=

# --- Stage 5: text-to-speech (NOT IMPLEMENTED YET — config only) -----------
# Engine name, e.g. "pyttsx3" (local) or "edge".
# optional at this stage — not required for Stage 0
# PEEKO_TTS_ENGINE=
# Voice identifier, e.g. en-US-JennyNeural.
# optional at this stage — not required for Stage 0
# PEEKO_TTS_VOICE=
